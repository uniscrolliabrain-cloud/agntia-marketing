{
  "name": "agntia-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SaaS especialista de marketing: implementaci\u00f3n de las 42 campa\u00f1as (MKT-C01..C42)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:dev": "tsx apps/api/src/server.ts",
    "worker:dev": "tsx apps/worker/src/main.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "pack:sdk": "node scripts/pack-packages.mjs",
    "verify:pack": "node scripts/verify-pack-install.mjs"
  },
  "devDependencies": {
